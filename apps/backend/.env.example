# Server
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/afridollar?schema=public"

# JWT
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_key
JWT_SECRET=your-secret-key

# Encryption (used for AES-256-GCM secret key encryption)
# Generate a unique key per environment: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-char-hex-string

# Stellar
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK=testnet
STELLAR_SECRET_KEY=
STELLAR_TOML_SIGNING_KEY=

# SEP-10 / SEP-24 Anchor
SEP10_HOME_DOMAIN=localhost:3001
SEP10_WEB_AUTH_DOMAIN=localhost:3001
SEP10_JWT_SECRET=replace-with-dedicated-sep10-jwt-secret
SEP24_INTERACTIVE_FRONTEND_BASE_URL=http://localhost:3000
SEP24_STATE_HMAC_SECRET=
SEP24_HOT_WALLET_PUBLIC_KEY=
SEP24_USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
SEP_API_PUBLIC_URL=http://localhost:3001

# Notification — Email (SendGrid)
SENDGRID_API_KEY=SG.your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@afridollar.com

# Notification — SMS (Twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+15550000000

# Notification — Push (web-push / VAPID)
# Generate keys: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_SUBJECT=mailto:admin@afridollar.com
